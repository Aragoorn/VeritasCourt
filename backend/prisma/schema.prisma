generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  COMPANY_USER
  RESOLVER          // جایگزین HUMAN_REVIEWER
  CLAIMANT
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  AI_REVIEWING
  RESOLVED          // به جای AI_RESOLVED
  CHALLENGED
  APPEALED
  FINALIZED         // فقط زمانی ست می‌شود که قرارداد finalize کرده باشد
  ARCHIVED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String?
  role          UserRole   @default(CLAIMANT)
  walletAddress String?    // آدرس ولت resolver یا کاربر
  companyId     String?
  company       Company?   @relation(fields: [companyId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  claimsCreated Claim[]    @relation("ClaimCreator")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  apiKey      String   @unique @default(cuid())
  webhookUrl  String?
  users       User[]
  claims      Claim[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Claim {
  id                String      @id @default(cuid())
  externalId        String?
  title             String
  description       String
  status            ClaimStatus @default(DRAFT)
  
  // لینک به قرارداد (منبع حقیقت)
  genlayerClaimId   String?     // claim_id در قرارداد
  genlayerTxHash    String?     // آخرین تراکنش مرتبط
  
  companyId         String
  company           Company     @relation(fields: [companyId], references: [id])
  creatorId         String
  creator           User        @relation("ClaimCreator", fields: [creatorId], references: [id])

  evidence          Evidence[]

  // فقط برای نمایش و ایندکس (نه منبع حقیقت)
  lastDecision      String?     // آخرین تصمیم خوانده‌شده از قرارداد
  lastConfidence    Int?
  finalizedOnChain  Boolean     @default(false)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([genlayerClaimId])
  @@index([status])
}

model Evidence {
  id          String   @id @default(cuid())
  claimId     String
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  url         String
  ipfsHash    String?
  fileName    String?
  mimeType    String?
  uploadedBy  String
  createdAt   DateTime @default(now())
}
